# Copia este archivo a .env para desarrollo local (make lo carga solo).
# Valores de desarrollo: no los reutilices en producción.

# ── API ──
SERVER_PORT=8080
CORS_ORIGINS=http://localhost:3000
LOG_FORMAT=text
LOG_LEVEL=info

# ── Base de datos ──
# Sin DATABASE_URL la API usa almacenamiento en memoria (los datos se pierden al reiniciar).
# La API debe conectarse con un rol SIN superusuario para que se aplique RLS.
DATABASE_URL=postgres://sgsi_app:sgsi_app_dev@localhost:5432/sgsi?sslmode=disable
# Rol administrador, usado solo por `make migrate`.
DATABASE_MIGRATE_URL=postgres://sgsi:sgsi_dev@localhost:5432/sgsi?sslmode=disable

# ── Autenticación ──
# Modo desarrollo: acepta cualquier correo y contraseña. NUNCA en producción.
AUTH_DEV_MODE=true
# OIDC_ISSUER=
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=

# ── Servicios auxiliares (aún no usados por la API) ──
REDIS_URL=redis://localhost:6379/0
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=sgsi-documents
S3_ACCESS_KEY=sgsi_minio
S3_SECRET_KEY=sgsi_minio_dev
